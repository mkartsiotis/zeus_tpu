#! /usr/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0-dirty)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/ivl/system.vpi";
:vpi_module "/usr/lib/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/ivl/va_math.vpi";
S_0x55b3ecf9ba70 .scope module, "mux2to1_tb" "mux2to1_tb" 2 1;
 .timescale 0 0;
v0x55b3ecfc61f0_0 .var "a", 0 0;
v0x55b3ecfc62b0_0 .var "b", 0 0;
v0x55b3ecfc6380_0 .var "sel", 0 0;
v0x55b3ecfc6480_0 .net "y", 0 0, L_0x55b3ecfc6810;  1 drivers
S_0x55b3ecfaf6d0 .scope module, "dut" "mux2to1" 2 5, 3 1 0, S_0x55b3ecf9ba70;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "A";
    .port_info 1 /INPUT 1 "B";
    .port_info 2 /INPUT 1 "X";
    .port_info 3 /OUTPUT 1 "out1";
L_0x55b3ecfc6550 .functor NOT 1, v0x55b3ecfc6380_0, C4<0>, C4<0>, C4<0>;
L_0x55b3ecfc6640 .functor AND 1, L_0x55b3ecfc6550, v0x55b3ecfc61f0_0, C4<1>, C4<1>;
L_0x55b3ecfc6750 .functor AND 1, v0x55b3ecfc6380_0, v0x55b3ecfc62b0_0, C4<1>, C4<1>;
L_0x55b3ecfc6810 .functor OR 1, L_0x55b3ecfc6640, L_0x55b3ecfc6750, C4<0>, C4<0>;
v0x55b3ecfaf8b0_0 .net "A", 0 0, v0x55b3ecfc61f0_0;  1 drivers
v0x55b3ecfc5cc0_0 .net "B", 0 0, v0x55b3ecfc62b0_0;  1 drivers
v0x55b3ecfc5d80_0 .net "X", 0 0, v0x55b3ecfc6380_0;  1 drivers
v0x55b3ecfc5e20_0 .net "not_X", 0 0, L_0x55b3ecfc6550;  1 drivers
v0x55b3ecfc5ee0_0 .net "out1", 0 0, L_0x55b3ecfc6810;  alias, 1 drivers
v0x55b3ecfc5ff0_0 .net "out_and1", 0 0, L_0x55b3ecfc6640;  1 drivers
v0x55b3ecfc60b0_0 .net "out_and2", 0 0, L_0x55b3ecfc6750;  1 drivers
    .scope S_0x55b3ecf9ba70;
T_0 ;
    %vpi_call 2 13 "$dumpfile", "sim/dump.vcd" {0 0 0};
    %vpi_call 2 14 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x55b3ecf9ba70 {0 0 0};
    %vpi_call 2 17 "$display", "Time | sel a b | y" {0 0 0};
    %vpi_call 2 18 "$display", "-------------------" {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55b3ecfc6380_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55b3ecfc61f0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55b3ecfc62b0_0, 0, 1;
    %delay 10, 0;
    %vpi_call 2 25 "$display", "%4t |  %b  %b %b | %b", $time, v0x55b3ecfc6380_0, v0x55b3ecfc61f0_0, v0x55b3ecfc62b0_0, v0x55b3ecfc6480_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55b3ecfc61f0_0, 0, 1;
    %delay 10, 0;
    %vpi_call 2 30 "$display", "%4t |  %b  %b %b | %b", $time, v0x55b3ecfc6380_0, v0x55b3ecfc61f0_0, v0x55b3ecfc62b0_0, v0x55b3ecfc6480_0 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55b3ecfc6380_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55b3ecfc61f0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55b3ecfc62b0_0, 0, 1;
    %delay 10, 0;
    %vpi_call 2 37 "$display", "%4t |  %b  %b %b | %b", $time, v0x55b3ecfc6380_0, v0x55b3ecfc61f0_0, v0x55b3ecfc62b0_0, v0x55b3ecfc6480_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55b3ecfc6380_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55b3ecfc61f0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55b3ecfc62b0_0, 0, 1;
    %delay 10, 0;
    %vpi_call 2 43 "$display", "%4t |  %b  %b %b | %b", $time, v0x55b3ecfc6380_0, v0x55b3ecfc61f0_0, v0x55b3ecfc62b0_0, v0x55b3ecfc6480_0 {0 0 0};
    %vpi_call 2 45 "$finish" {0 0 0};
    %end;
    .thread T_0;
